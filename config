/* ============ Erinnerungen ============ */
function hasPush(){return typeof window.KF20!=="undefined"&&KF20&&typeof KF20.schedule==="function";}
function hm(v,dh,dm){const m=/^(\d{1,2}):(\d{2})$/.exec(v||"");return m?[+m[1],+m[2]]:[dh,dm];}
function applyReminders(){
  if(!hasPush())return false;
  const r=DB.profile.reminders||{};
  if(r.on===false)return false;
  const a=hm(r.morning,7,30),b=hm(r.evening,21,0),c=hm(r.weekly,19,0);
  try{
    KF20.schedule(1,a[0],a[1],false,"Morgen-Check","Sport-kcal, Energie, Hunger, Gewicht — dann steht dein Tagesziel.");
    KF20.schedule(2,b[0],b[1],false,"Tagesbilanz","Alles eingetragen? Tracker-Verbrauch nicht vergessen.");
    KF20.schedule(3,c[0],c[1],true,"Wochen-Report","Woche abgeschlossen — Report ansehen.");
    return true;
  }catch(e){return false;}
}
function saveReminders(){
  DB.profile.reminders=Object.assign(DB.profile.reminders||{},{
    morning:document.getElementById("rMorning").value||"07:30",
    evening:document.getElementById("rEvening").value||"21:00",
    weekly:document.getElementById("rWeekly").value||"19:00",on:true});
  save();
  toast(applyReminders()?"Erinnerungen gesetzt":"Nur in der Android-App aktiv");
  renderBody();
}
function testPush(){
  if(!hasPush()){toast("Nur in der Android-App verfügbar");return;}
  try{KF20.test();toast("Benachrichtigung gesendet");}catch(e){toast("Fehlgeschlagen");}
}

