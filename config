/* ============ Helfer ============ */
const R=n=>Math.round(n);
const de=n=>(Math.round(n)).toLocaleString("de-DE");
const de1=n=>n.toLocaleString("de-DE",{minimumFractionDigits:1,maximumFractionDigits:1});
const pad=n=>String(n).padStart(2,"0");
function today(){const t=new Date();return t.getFullYear()+"-"+pad(t.getMonth()+1)+"-"+pad(t.getDate());}
function nowTime(){const t=new Date();return pad(t.getHours())+":"+pad(t.getMinutes());}
function dayNo(date){const a=new Date(DB.profile.start+"T00:00:00"),b=new Date(date+"T00:00:00");
  return Math.round((b-a)/86400000)+1;}
function fmtDate(date){const d=new Date(date+"T00:00:00");
  return ["So","Mo","Di","Mi","Do","Fr","Sa"][d.getDay()]+" "+pad(d.getDate())+"."+pad(d.getMonth()+1)+".";}
function getDay(date){
  if(!DB.days[date]) DB.days[date]={date,morning:{},sport:null,tracker:null,target:null,meals:[],totals:null};
  return DB.days[date];
}
function factorFor(energy){const r=DB.profile.refeed;
  return (energy>=8?r.high:energy>=5?r.normal:r.low)/100;}
function targetFor(day){
  const P=DB.profile, sport=day.sport||0, e=(day.morning&&day.morning.energy)||7, rf=factorFor(e);
  const kcal=P.base+sport*rf;
  return {kcal:R(kcal),p:P.protein,f:P.fat,c:R((kcal-P.protein*4-P.fat*9)/4),rf};
}
function totals(day){
  if(day.imported&&day.totals) return day.totals;
  return day.meals.reduce((a,m)=>({kcal:a.kcal+m.kcal,p:a.p+m.p,f:a.f+m.f,c:a.c+m.c}),{kcal:0,p:0,f:0,c:0});
}
function toast(t){const el=document.getElementById("toast");el.textContent=t;el.classList.add("show");
  clearTimeout(el._t);el._t=setTimeout(()=>el.classList.remove("show"),1800);}

/* ============ Parser ============ */
function foods(){const m={};for(const k in BASE_FOODS)m[k]=BASE_FOODS[k];
  for(const k in DB.foods)m[k]=DB.foods[k];return m;}
function parse(text){
  const F=foods();
  const keys=Object.keys(F).sort((a,b)=>b.length-a.length);
  return text.split(/[,;\n]|\s+und\s+|\s\+\s/).map(s=>s.trim()).filter(Boolean).map(part=>{
    const m=part.match(/^(?:(\d+(?:[.,]\d+)?)\s*)?([a-zA-ZäöüÄÖÜß]+)?\s*(.*)$/);
    let qty=m&&m[1]?parseFloat(m[1].replace(",",".")):null;
    let unit=m&&m[2]?UNITS[m[2].toLowerCase()]:null;
    let name=unit?(m[3]||""):((m[2]||"")+" "+(m[3]||""));
    name=name.trim();
    const low=(name||part).toLowerCase();
    const key=keys.find(k=>low.includes(k));
    if(!key) return {raw:part,name:name||part,unknown:true,qty,unit};
    const f=F[key];
    if(unit!=="l"&&(!unit||!f.u[unit])) unit=Object.keys(f.u)[0];
    if(qty===null) qty=(unit==="g"||unit==="ml")?100:1;
    const grams=unit==="l"?qty*1000:qty*f.u[unit];
    return {raw:part,key,name:f.n,qty,unit,grams,warn:grams>800,
      kcal:f.v.kcal*grams/100,p:f.v.p*grams/100,f:f.v.f*grams/100,c:f.v.c*grams/100};
  });
}

/* ============ Rendering: Heute ============ */
let VIEW=today();
function render(){
  const day=getDay(VIEW), t=targetFor(day), e=totals(day), rest=t.kcal-e.kcal;
  document.getElementById("hSub").textContent=fmtDate(VIEW)+" · Tag "+dayNo(VIEW);
  const mo=day.morning||{};
  document.getElementById("hBadge").textContent=mo.weight
    ?de1(mo.weight)+" kg"+(mo.bodyfat?" · "+de1(mo.bodyfat)+" %":""):"kein Wiegen";

  const pct=Math.min(e.kcal/t.kcal,1);
  const arc=document.getElementById("ringArc");
  arc.style.strokeDashoffset=339-339*pct;
  arc.setAttribute("stroke",e.kcal>t.kcal?"#f0883e":"#3fb950");
  document.getElementById("ringRest").textContent=de(rest);
  document.getElementById("kTarget").textContent=de(t.kcal)+" kcal";
  document.getElementById("kEaten").textContent=de(e.kcal)+" kcal";
  document.getElementById("kSport").textContent=day.sport?de(day.sport)+" kcal":"—";
  document.getElementById("kDef").textContent=day.tracker?"−"+de(day.tracker-e.kcal)+" kcal":"Tracker fehlt";
  document.getElementById("kDef").style.color=day.tracker?"var(--accent)":"var(--muted)";

  document.getElementById("macros").innerHTML=[["Protein","p","#58a6ff"],["Fett","f","#d29922"],["Carbs","c","#a371f7"]]
    .map(([lbl,k,col])=>{const cur=e[k],goal=t[k],pc=Math.round(cur/goal*100),over=pc>105;
      return `<div class="m"><div class="top"><b>${lbl}</b><span class="val" style="${over?'color:var(--warn)':''}">${R(cur)} / ${goal} g · ${pc} %</span></div>
      <div class="bar"><i style="width:${Math.min(pc,100)}%;background:${over?'#f0883e':col}"></i></div></div>`;}).join("");

  document.getElementById("calcBox").innerHTML=
    `Basis-Ziel <b>${de(DB.profile.base)} kcal</b><br>
     Sport laut Tracker <b>${day.sport?de(day.sport)+" kcal":"noch offen"}</b><br>
     Energie <b>${mo.energy||"–"}/10</b> → Refeed <b>${R(t.rf*100)} %</b><br>
     Aufschlag ${de(day.sport||0)} × ${String(t.rf).replace(".",",")} = <b>+${de((day.sport||0)*t.rf)} kcal</b><br>
     <span style="color:var(--text)">Tagesziel = <b>${de(t.kcal)} kcal</b></span><br>
     Carbs = (${de(t.kcal)} − ${t.p}×4 − ${t.f}×9) / 4 = <b>${t.c} g</b>`;

  const ml=document.getElementById("mealList");
  if(day.imported&&!day.meals.length){
    ml.innerHTML=`<div class="note">Importierter Tag aus dem Chat-Log — Tagessummen vorhanden, keine Einzelmahlzeiten.</div>`;
  }else{
    ml.innerHTML=day.meals.map((m,i)=>
      `<div class="meal" onclick="openMeal(${i})"><div class="t">${m.time}</div>
        <div class="body"><div class="name">${m.slot}</div><div class="desc">${esc(m.raw)}</div>
          <div class="macros">${R(m.p)} g P · ${R(m.f)} g F · ${R(m.c)} g C</div></div>
        <div class="kcal">${de(m.kcal)}</div></div>`).join("")
      ||`<div class="note">Noch nichts erfasst.</div>`;
  }

  const fp=Math.round(e.f/t.f*100);
  const items=[["Kalorien",e.kcal,t.kcal,"kcal","#3fb950"],["Protein",e.p,t.p,"g","#58a6ff"],
               ["Fett",e.f,t.f,"g","#d29922"],["Carbs",e.c,t.c,"g","#a371f7"]];
  document.getElementById("restBars").innerHTML=items.map(([lbl,cur,goal,unit,col])=>{
    const left=goal-cur, pc=goal?cur/goal*100:0;
    const fill=Math.min(pc,100), over=Math.max(pc-100,0);
    const overW=Math.min(over,60);
    return `<div class="rest">
      <div class="rt"><span class="rl">${lbl}</span>
        <span class="rv" style="color:${left<0?"var(--bad)":"var(--text)"}">${left<0?"+"+de(-left):de(left)}
          <small>${unit} ${left<0?"über Limit":"offen"}</small></span></div>
      <div class="rb"><i style="width:${fill.toFixed(1)}%;background:${col}"></i>
        ${over>0?`<i class="over" style="width:${overW.toFixed(1)}%"></i>`:""}</div>
      <div class="rs">${de(cur)} von ${de(goal)} ${unit} · ${Math.round(pc)} %</div></div>`;}).join("");
  document.getElementById("restHint").innerHTML=
    (e.kcal===0?"Noch nichts eingetragen — der Tag ist offen."
     :fp>75?`⚠️ Fett bei ${fp} % des Limits — Abend fettarm: mageres Protein, Gemüse, wenig Öl und Käse.`
     :(e.p/t.p*100)<(e.kcal/t.kcal*100)-10?`Protein hinkt hinterher — nächste Mahlzeit proteinbetont wählen.`
     :`Im Rahmen. Fett bei ${fp} %, Protein bei ${Math.round(e.p/t.p*100)} %.`);

  document.getElementById("iTracker").value=day.tracker||"";
  document.getElementById("morningBanner").innerHTML=(mo.weight||day.sport!==null)?"":
    `<div class="card" style="border-color:#2f6f3a"><h3 style="color:var(--accent)">Morgen-Check offen</h3>
      <div class="note" style="margin:0 0 10px">Sport, Energie, Hunger, Gewicht — danach steht dein Tagesziel.</div>
      <button class="primary" onclick="openMorning()">Jetzt eintragen</button></div>`;

  const tpl=[["Standard-Frühstück","Frühstück","30g Proteinpulver, 25g Haferflocken, 3 EL Skyr, 20g Nussmix"],
             ["Clear Whey","Snack","30g clear whey"],["Proteinshake","Snack","30g Whey, 200ml Sojamilch"]];
  document.getElementById("quickChips").innerHTML=tpl.map(([n,s,r])=>
    `<div class="chip" onclick="quickAdd('${s}',${JSON.stringify(r).replace(/"/g,"&quot;")})">＋ ${n}</div>`).join("")+
    `<div class="chip" onclick="openAdd()">＋ Freitext</div>`;
}
function esc(s){return String(s).replace(/[<>&]/g,c=>({"<":"&lt;",">":"&gt;","&":"&amp;"}[c]));}

/* ============ Erfassen ============ */
let SLOT="Frühstück", PENDING=null, EDIT_IDX=null;
function slotChips(){
  document.getElementById("slotChips").innerHTML=["Frühstück","Mittag","Snack","Abend","Getränk"]
    .map(s=>`<div class="chip ${s===SLOT?"on":""}" onclick="setSlot('${s}')">${s}</div>`).join("");
}
function setSlot(s){SLOT=s;slotChips();}
function doParse(){
  const txt=document.getElementById("freeText").value.trim();
  if(!txt){toast("Erst etwas eingeben");return;}
  PENDING={rows:parse(txt),raw:txt};
  showParse();
}
function showParse(){
  const rows=PENDING.rows, known=rows.filter(r=>!r.unknown);
  const s=known.reduce((a,r)=>({kcal:a.kcal+r.kcal,p:a.p+r.p,f:a.f+r.f,c:a.c+r.c}),{kcal:0,p:0,f:0,c:0});
  document.getElementById("parseCard").style.display="block";
  document.getElementById("parseSum").textContent=de(s.kcal)+" kcal";
  document.getElementById("parsedRows").innerHTML=rows.map((r,i)=>r.unknown
    ? `<div class="prow unknown"><div class="pn">${esc(r.name)}<small>unbekannt — antippen zum Anlegen</small></div>
       <span class="chip" onclick="newFood(${i})">anlegen</span><span class="x" onclick="dropRow(${i})">×</span></div>`
    : `<div class="prow"><div class="pn">${esc(r.name)}<small>${String(r.qty).replace(".",",")} ${r.unit} = ${R(r.grams)} g · ${R(r.p)} P / ${R(r.f)} F / ${R(r.c)} C</small></div>
       <div class="pk">${R(r.kcal)}</div><span class="x" onclick="dropRow(${i})">×</span></div>`).join("");
  const w=rows.filter(r=>r.warn), el=document.getElementById("parseWarn");
