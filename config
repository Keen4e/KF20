<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>KF20</title>
<style>
:root{
  --bg:#0d1117; --surface:#161b22; --surface2:#1c232c; --line:#2a323d;
  --text:#e6edf3; --muted:#8b949e;
  --accent:#3fb950; --accent-dim:#238636;
  --p:#58a6ff; --f:#d29922; --c:#a371f7;
  --warn:#f0883e; --bad:#f85149; --r:14px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0;background:var(--bg);color:var(--text);overscroll-behavior:none;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,system-ui,sans-serif;}
body{display:flex;flex-direction:column;height:100vh;overflow:hidden}
header{padding:calc(12px + env(safe-area-inset-top)) 18px 10px;display:flex;align-items:flex-end;
  justify-content:space-between;border-bottom:1px solid var(--line);flex-shrink:0}
header h1{font-size:19px;margin:0;letter-spacing:-.3px}
header .sub{font-size:11.5px;color:var(--muted);margin-top:2px}
.badge{font-size:10.5px;background:var(--surface2);color:var(--muted);padding:4px 9px;border-radius:20px;border:1px solid var(--line)}
main{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:14px 16px 96px}
.screen{display:none}.screen.active{display:block}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:14px;margin-bottom:12px}
.card h3{margin:0 0 10px;font-size:13px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.6px}
.ringwrap{display:flex;align-items:center;gap:16px}
.ring{position:relative;width:128px;height:128px;flex-shrink:0}
.ring svg{transform:rotate(-90deg)}
.ring .mid{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.ring .big{font-size:28px;font-weight:700;letter-spacing:-1px;line-height:1}
.ring .lbl{font-size:10px;color:var(--muted);margin-top:3px;text-transform:uppercase;letter-spacing:.5px}
.kv{flex:1;display:flex;flex-direction:column;gap:9px}
.kv .row{display:flex;justify-content:space-between;font-size:12.5px}
.kv .row span:last-child{font-variant-numeric:tabular-nums;font-weight:600}
.macro{margin-top:14px}.macro .m{margin-bottom:11px}.macro .m:last-child{margin-bottom:0}
.macro .top{display:flex;justify-content:space-between;font-size:12px;margin-bottom:5px}
.macro .val{color:var(--muted);font-variant-numeric:tabular-nums}
.bar{height:7px;background:var(--surface2);border-radius:20px;overflow:hidden}
.bar i{display:block;height:100%;border-radius:20px;transition:width .45s cubic-bezier(.22,1,.36,1)}
details.calc{margin-top:12px;border-top:1px solid var(--line);padding-top:10px}
details.calc summary{font-size:12px;color:var(--muted);list-style:none;cursor:pointer}
details.calc summary::-webkit-details-marker{display:none}
details.calc summary::before{content:"▸ "}details.calc[open] summary::before{content:"▾ "}
.formula{margin-top:9px;font-size:12px;line-height:1.75;color:var(--muted);font-variant-numeric:tabular-nums}
.formula b{color:var(--text)}
.meal{display:flex;gap:11px;padding:11px 0;border-bottom:1px solid var(--line);cursor:pointer}
.meal:last-child{border-bottom:none;padding-bottom:0}
.meal .t{font-size:11px;color:var(--muted);width:38px;flex-shrink:0;padding-top:2px;font-variant-numeric:tabular-nums}
.meal .body{flex:1;min-width:0}
.meal .name{font-size:13.5px;font-weight:600;margin-bottom:2px}
.meal .desc{font-size:11.5px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.meal .macros{font-size:10.5px;color:var(--muted);margin-top:4px;font-variant-numeric:tabular-nums}
.meal .kcal{font-size:14px;font-weight:700;font-variant-numeric:tabular-nums;padding-top:2px}
.chips{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}
.chip{background:var(--surface2);border:1px solid var(--line);color:var(--text);font-size:11.5px;
  padding:7px 11px;border-radius:20px;cursor:pointer}
.chip.on{background:var(--accent-dim);border-color:var(--accent);color:#fff}
button.primary{width:100%;background:var(--accent-dim);color:#fff;border:none;padding:13px;border-radius:11px;
  font-size:14px;font-weight:600;font-family:inherit;cursor:pointer}
button.ghost{width:100%;background:transparent;color:var(--muted);border:1px solid var(--line);padding:11px;
  border-radius:11px;font-size:13px;font-family:inherit;margin-top:8px;cursor:pointer}
button.danger{color:var(--bad);border-color:#5c2626}
textarea,input,select{width:100%;background:var(--surface2);border:1px solid var(--line);color:var(--text);
  border-radius:11px;padding:11px;font-size:15px;font-family:inherit;resize:none}
input:focus,textarea:focus{outline:none;border-color:var(--accent)}
label.fl{display:block;font-size:11.5px;color:var(--muted);margin:12px 0 5px}
.two{display:flex;gap:9px}.two>div{flex:1}
.prow{display:flex;align-items:center;gap:9px;padding:9px;background:var(--surface2);border-radius:10px;
  margin-bottom:7px;border-left:3px solid var(--accent)}
.prow.unknown{border-left-color:var(--warn)}
.prow .pn{flex:1;font-size:12.5px;min-width:0}
.prow .pn small{display:block;color:var(--muted);font-size:10.5px;margin-top:2px}
.prow .pk{font-size:12.5px;font-weight:600;font-variant-numeric:tabular-nums}
.prow .x{color:var(--muted);font-size:17px;padding:0 4px;cursor:pointer}
.slider{width:100%;-webkit-appearance:none;height:5px;background:var(--surface2);border-radius:5px;margin:9px 0}
.slider::-webkit-slider-thumb{-webkit-appearance:none;width:26px;height:26px;border-radius:50%;background:var(--accent);border:3px solid var(--bg)}
.sval{float:right;font-weight:700;font-variant-numeric:tabular-nums}
table{width:100%;border-collapse:collapse;font-size:11.5px;font-variant-numeric:tabular-nums}
th{text-align:right;color:var(--muted);font-weight:500;padding:5px 3px;border-bottom:1px solid var(--line);font-size:10.5px}
th:first-child,td:first-child{text-align:left}
td{text-align:right;padding:6px 3px;border-bottom:1px solid var(--line)}
tr:last-child td{border-bottom:none}
tr.sum td{font-weight:700;border-top:1px solid var(--line);border-bottom:none}
nav{background:rgba(13,17,23,.96);border-top:1px solid var(--line);display:flex;
  padding:7px 4px calc(8px + env(safe-area-inset-bottom));flex-shrink:0}
nav button{flex:1;background:none;border:none;color:var(--muted);font-size:9.5px;cursor:pointer;
  display:flex;flex-direction:column;align-items:center;gap:3px;padding:5px 0;font-family:inherit}
nav button.on{color:var(--accent)}
nav svg{width:21px;height:21px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
.fab{position:fixed;right:18px;bottom:calc(84px + env(safe-area-inset-bottom));width:54px;height:54px;border-radius:50%;
  background:var(--accent-dim);border:none;color:#fff;font-size:27px;box-shadow:0 6px 22px rgba(35,134,54,.45);
  display:flex;align-items:center;justify-content:center;line-height:1;z-index:20}
.sheet{position:fixed;inset:0;background:rgba(0,0,0,.6);display:none;align-items:flex-end;z-index:50}
.sheet.open{display:flex}
.sheet .inner{background:var(--surface);width:100%;max-height:90%;overflow-y:auto;border-radius:22px 22px 0 0;
  padding:18px 18px calc(26px + env(safe-area-inset-bottom));animation:up .22s cubic-bezier(.22,1,.36,1)}
@keyframes up{from{transform:translateY(100%)}to{transform:none}}
.grab{width:36px;height:4px;background:var(--line);border-radius:4px;margin:0 auto 14px}
.sheet h2{margin:0 0 4px;font-size:17px}.sheet .sh{font-size:12px;color:var(--muted);margin-bottom:14px}
.hint{background:rgba(63,185,80,.09);border:1px solid rgba(63,185,80,.28);border-radius:11px;padding:11px;
  font-size:12px;line-height:1.55;color:#c8e6c9}
.hint.warn{background:rgba(240,136,62,.09);border-color:rgba(240,136,62,.3);color:#f5cba7}
.hint.info{background:rgba(88,166,255,.08);border-color:rgba(88,166,255,.25);color:#bcd9ff}
.stat{display:flex;gap:9px;margin-bottom:12px}
.stat div{flex:1;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:11px 9px;text-align:center}
.stat .n{font-size:19px;font-weight:700;letter-spacing:-.5px;font-variant-numeric:tabular-nums}
.stat .l{font-size:9.5px;color:var(--muted);margin-top:3px;text-transform:uppercase;letter-spacing:.4px}
.stat .d{font-size:10px;margin-top:3px}
.up{color:var(--bad)}.down{color:var(--accent)}
.heat{display:grid;grid-template-columns:repeat(11,1fr);gap:4px}
.heat i{aspect-ratio:1;border-radius:3px;background:var(--surface2)}
.legend{display:flex;gap:12px;font-size:10.5px;color:var(--muted);margin-top:9px;flex-wrap:wrap}
.legend i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:4px;vertical-align:-1px}
.note{font-size:11px;color:var(--muted);line-height:1.6;margin-top:9px}
.rest{margin-bottom:13px}
.rest:last-of-type{margin-bottom:4px}
.rest .rt{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:5px}
.rest .rl{font-size:12.5px;font-weight:600}
.rest .rv{font-size:15px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-.3px}
.rest .rv small{font-size:10.5px;font-weight:500;color:var(--muted);margin-left:4px}
.rest .rb{height:9px;background:var(--surface2);border-radius:20px;overflow:hidden;display:flex}
.rest .rb i{display:block;height:100%;transition:width .45s cubic-bezier(.22,1,.36,1)}
.rest .rb i.over{background:repeating-linear-gradient(45deg,#f85149,#f85149 4px,#c9372f 4px,#c9372f 8px)}
.rest .rs{font-size:10.5px;color:var(--muted);margin-top:4px;font-variant-numeric:tabular-nums}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:110px;background:#1f6f2e;color:#fff;
  padding:10px 16px;border-radius:22px;font-size:12.5px;z-index:99;opacity:0;transition:opacity .2s;pointer-events:none}
.toast.show{opacity:1}
.foodrow{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--line);font-size:12.5px}
.foodrow small{color:var(--muted);font-size:10.5px}
</style>
</head>
<body>
<header>
  <div><h1 id="hTitle">Heute</h1><div class="sub" id="hSub"></div></div>
  <div class="badge" id="hBadge">—</div>
</header>

<main>
<!-- HEUTE -->
<section class="screen active" id="s-heute">
  <div id="morningBanner"></div>
  <div class="card">
    <div class="ringwrap">
      <div class="ring">
        <svg width="128" height="128" viewBox="0 0 128 128">
          <circle cx="64" cy="64" r="54" stroke="#1c232c" stroke-width="11" fill="none"/>
          <circle id="ringArc" cx="64" cy="64" r="54" stroke="#3fb950" stroke-width="11" fill="none"
            stroke-linecap="round" stroke-dasharray="339" stroke-dashoffset="339"/>
        </svg>
        <div class="mid"><div class="big" id="ringRest">—</div><div class="lbl">kcal übrig</div></div>
      </div>
      <div class="kv">
        <div class="row"><span style="color:var(--muted)">Tagesziel</span><span id="kTarget">—</span></div>
        <div class="row"><span style="color:var(--muted)">Gegessen</span><span id="kEaten">—</span></div>
        <div class="row"><span style="color:var(--muted)">Sport</span><span id="kSport">—</span></div>
        <div class="row"><span style="color:var(--muted)">Netto vs. Tracker</span><span id="kDef">—</span></div>
      </div>
    </div>
    <div class="macro" id="macros"></div>
    <details class="calc"><summary>Wie kommt das Tagesziel zustande?</summary><div class="formula" id="calcBox"></div></details>
  </div>

  <div class="card">
    <h3>Mahlzeiten</h3>
    <div id="mealList"></div>
    <div class="chips" id="quickChips"></div>
  </div>

  <div class="card">
    <h3>Rest des Tages</h3>
    <div id="restBars"></div>
    <div class="hint" id="restHint"></div>
    <label class="fl">Tracker-Tagesverbrauch (abends eintragen)</label>
    <div class="two">
      <div><input type="number" id="iTracker" placeholder="z. B. 2700" inputmode="numeric"></div>
      <div><button class="primary" onclick="saveTracker()">Speichern</button></div>
    </div>
  </div>
</section>

<!-- ERFASSEN -->
<section class="screen" id="s-erfassen">
  <div class="card">
    <h3>Mahlzeit erfassen</h3>
    <textarea id="freeText" rows="3" placeholder="30g Proteinpulver, 25g Haferflocken, 3 EL Skyr"></textarea>
    <div class="chips" id="slotChips"></div>
    <div style="margin-top:12px"><button class="primary" onclick="doParse()">Erkennen</button></div>
    <div class="chips" id="tplChips"></div>
  </div>
  <div class="card" id="parseCard" style="display:none">
    <h3>Erkannt <span style="float:right;font-weight:700;color:var(--text)" id="parseSum"></span></h3>
    <div id="parsedRows"></div>
    <div class="hint warn" id="parseWarn" style="display:none"></div>
    <div style="margin-top:12px"><button class="primary" onclick="commitMeal()">Eintragen</button></div>
    <button class="ghost" onclick="cancelParse()">Verwerfen</button>
  </div>
  <div class="card">
    <h3>Zeitpunkt</h3>
    <div class="two">
      <div><label class="fl">Datum</label><input type="date" id="iDate"></div>
      <div><label class="fl">Uhrzeit</label><input type="time" id="iTime"></div>
    </div>
    <div class="note">Standard ist jetzt. Für Nachträge einfach Datum zurückstellen — der Eintrag landet im richtigen Tageslog.</div>
  </div>
</section>

<!-- TRENDS -->
<section class="screen" id="s-trends">
  <div class="stat" id="trendStats"></div>
  <div class="card">
    <h3>Gewicht · Punkte = Tag, Linie = 7-Tage-Ø</h3>
    <div id="chartWeight"></div>
    <div class="legend"><span><i style="background:var(--muted)"></i>Einzeltag</span><span><i style="background:var(--accent)"></i>7-Tage-Ø</span></div>
    <div class="note">Einzelne Tage schwanken durch Wasser und Glykogen um bis zu 1,5 kg. Bewertet wird nur die Linie.</div>
  </div>
  <div class="card"><h3>KFA · Waage</h3><div id="chartBf"></div></div>
  <div class="card"><h3>Kalorien vs. Tagesziel</h3><div id="chartKcal"></div></div>
  <div class="card"><h3>Protein-Adherence</h3><div class="heat" id="heat"></div>
    <div class="legend"><span><i style="background:#1c232c"></i>keine Daten</span><span><i style="background:#1d4d2b"></i>70–90 %</span>
      <span><i style="background:#238636"></i>90–100 %</span><span><i style="background:#3fb950"></i>&gt;100 %</span></div></div>
</section>

<!-- WOCHE -->
<section class="screen" id="s-woche">
  <div class="card">
    <h3 id="weekTitle">Wochen-Report</h3>
    <table><thead><tr><th>Tag</th><th>kcal</th><th>P</th><th>F</th><th>C</th><th>kg</th></tr></thead><tbody id="weekBody"></tbody></table>
    <div class="chips"><div class="chip" onclick="shiftWeek(-1)">◀ Vorwoche</div><div class="chip" onclick="shiftWeek(1)">Folgewoche ▶</div></div>
  </div>
  <div class="card"><h3>Bilanz</h3><table id="weekBalance"></table></div>
  <div class="card"><h3>Auffälligkeiten</h3><div id="weekFindings"></div></div>
</section>

<!-- KÖRPER -->
<section class="screen" id="s-koerper">
  <div class="card">
    <h3>Morgen-Metriken</h3>
    <div class="two">
      <div><label class="fl">Gewicht kg</label><input type="number" step="0.05" id="mWeight" inputmode="decimal"></div>
      <div><label class="fl">KFA Waage %</label><input type="number" step="0.1" id="mBf" inputmode="decimal"></div>
    </div>
    <div style="margin-top:12px"><button class="primary" onclick="saveMetrics()">Speichern</button></div>
  </div>
  <div class="card">
    <h3>Navy-KFA</h3>
    <div class="two">
      <div><label class="fl">Bauch cm</label><input type="number" step="0.5" id="nWaist" inputmode="decimal" oninput="navy()"></div>
      <div><label class="fl">Hals cm</label><input type="number" step="0.5" id="nNeck" inputmode="decimal" oninput="navy()"></div>
    </div>
    <label class="fl">Hüfte cm</label><input type="number" step="0.5" id="nHip" inputmode="decimal" oninput="navy()">
    <div class="hint" id="navyOut" style="margin-top:14px"></div>
    <div style="margin-top:12px"><button class="primary" onclick="saveNavy()">Messung speichern</button></div>
    <div class="note">Metrische US-Navy-Formel. Morgens nüchtern messen, vor der ersten Mahlzeit, gleicher Bandzug.</div>
  </div>
  <div class="card"><h3>Messungen</h3><div id="measList"></div></div>
  <div class="card">
    <h3>Profil</h3>
    <div class="two">
      <div><label class="fl">Basis-kcal</label><input type="number" id="pBase" inputmode="numeric"></div>
      <div><label class="fl">Größe cm</label><input type="number" id="pHeight" inputmode="numeric"></div>
    </div>
    <div class="two">
      <div><label class="fl">Protein g</label><input type="number" id="pProt" inputmode="numeric"></div>
      <div><label class="fl">Fett g</label><input type="number" id="pFat" inputmode="numeric"></div>
    </div>
    <label class="fl">Refeed-Faktoren % (müde / normal / brennt)</label>
    <div class="two">
      <div><input type="number" id="pR1" inputmode="numeric"></div>
      <div><input type="number" id="pR2" inputmode="numeric"></div>
      <div><input type="number" id="pR3" inputmode="numeric"></div>
    </div>
    <div style="margin-top:12px"><button class="primary" onclick="saveProfile()">Profil speichern</button></div>
  </div>
  <div class="card">
    <h3>Lebensmittel-Datenbank</h3>
    <div id="foodList"></div>
    <button class="ghost" onclick="openSheet('sFood')">＋ Lebensmittel anlegen</button>
  </div>
  <div class="card">
    <h3>Erinnerungen</h3>
    <div id="pushState"></div>
    <div class="two">
      <div><label class="fl">Morgen-Check</label><input type="time" id="rMorning"></div>
      <div><label class="fl">Tagesbilanz</label><input type="time" id="rEvening"></div>
    </div>
    <label class="fl">Wochen-Report — sonntags</label><input type="time" id="rWeekly">
    <div style="margin-top:12px"><button class="primary" onclick="saveReminders()">Erinnerungen setzen</button></div>
    <button class="ghost" onclick="testPush()">Test-Benachrichtigung senden</button>
  </div>

  <div class="card">
    <h3>Daten</h3>
    <button class="ghost" onclick="doExport()">Export — alle Daten als JSON</button>
    <button class="ghost" onclick="openSheet('sImport')">Import</button>
    <div class="note" id="dataNote"></div>
  </div>
</section>
</main>

<button class="fab" onclick="openAdd()">＋</button>

<nav>
  <button class="on" data-s="heute" onclick="go('heute')"><svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>Heute</button>
  <button data-s="erfassen" onclick="go('erfassen')"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Erfassen</button>
  <button data-s="trends" onclick="go('trends')"><svg viewBox="0 0 24 24"><path d="M3 17l6-6 4 4 8-8"/><path d="M17 7h4v4"/></svg>Trends</button>
  <button data-s="woche" onclick="go('woche')"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>Woche</button>
  <button data-s="koerper" onclick="go('koerper')"><svg viewBox="0 0 24 24"><circle cx="12" cy="6" r="3"/><path d="M6 21v-3a6 6 0 0 1 12 0v3"/></svg>Körper</button>
</nav>

<!-- Morgen-Check -->
<div class="sheet" id="sMorning"><div class="inner">
  <div class="grab"></div><h2>Morgen-Check</h2><div class="sh" id="morningSub"></div>
  <label class="fl">Sport-Verbrauch laut Tracker <span class="sval" id="vSport">0 kcal</span></label>
  <input class="slider" type="range" id="iSport" min="0" max="1200" step="10" value="0" oninput="morningPreview()">
  <label class="fl">Energie <span class="sval" id="vEnergy">7 / 10</span></label>
  <input class="slider" type="range" id="iEnergy" min="1" max="10" value="7" oninput="morningPreview()">
  <label class="fl">Hunger <span class="sval" id="vHunger">4 / 10</span></label>
  <input class="slider" type="range" id="iHunger" min="1" max="10" value="4" oninput="morningPreview()">
  <div class="two">
    <div><label class="fl">Gewicht kg</label><input type="number" step="0.05" id="iWeight" inputmode="decimal"></div>
    <div><label class="fl">KFA Waage %</label><input type="number" step="0.1" id="iBf" inputmode="decimal"></div>
  </div>
  <div class="hint" id="morningOut" style="margin-top:14px"></div>
  <div style="margin-top:14px"><button class="primary" onclick="saveMorning()">Tag starten</button></div>
  <button class="ghost" onclick="closeSheet()">Später</button>
</div></div>

<!-- Mahlzeit bearbeiten -->
<div class="sheet" id="sMeal"><div class="inner">
  <div class="grab"></div><h2 id="mealTitle">Mahlzeit</h2><div class="sh" id="mealSub"></div>
  <div id="mealDetail"></div>
  <button class="ghost" onclick="reEditMeal()">Text bearbeiten und neu berechnen</button>
