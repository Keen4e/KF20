/* ============ Trends ============ */
function series(){
  return Object.values(DB.days).filter(d=>d.date<=today()).sort((a,b)=>a.date.localeCompare(b.date));
}
function avg7(arr,i){const s=arr.slice(Math.max(0,i-6),i+1).filter(v=>v!=null);
  return s.length?s.reduce((a,b)=>a+b,0)/s.length:null;}
function lineChart(el,vals,color){
  const pts=vals.map((v,i)=>[i,v]).filter(x=>x[1]!=null);
  const box=document.getElementById(el);
  if(pts.length<2){box.innerHTML='<div class="note">Zu wenige Daten.</div>';return;}
  const W=320,H=110,pd=8,min=Math.min(...pts.map(p=>p[1])),max=Math.max(...pts.map(p=>p[1]));
  const rng=(max-min)||1;
  const x=i=>pd+i*(W-2*pd)/(vals.length-1), y=v=>H-pd-(v-min)/rng*(H-2*pd);
  const sm=vals.map((_,i)=>avg7(vals,i));
  const line=sm.map((v,i)=>v==null?null:`${x(i).toFixed(1)},${y(v).toFixed(1)}`).filter(Boolean).join(" ");
  box.innerHTML=`<svg viewBox="0 0 ${W} ${H}" style="width:100%;height:${H}px;overflow:visible">
    ${pts.map(([i,v])=>`<circle cx="${x(i).toFixed(1)}" cy="${y(v).toFixed(1)}" r="1.9" fill="#8b949e" opacity=".65"/>`).join("")}
    <polyline points="${line}" fill="none" stroke="${color}" stroke-width="2.2" stroke-linejoin="round"/></svg>
    <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin-top:2px">
      <span>${de1(min)}</span><span>${de1(max)}</span></div>`;
}
function barChart(el,vals,goal){
  const box=document.getElementById(el),n=vals.length;
  if(!n){box.innerHTML='<div class="note">Keine Daten.</div>';return;}
  const W=320,H=110,pd=8,max=Math.max(...vals.map(v=>v||0),goal)*1.05,bw=(W-2*pd)/n;
  const bars=vals.map((v,i)=>{if(!v)return "";const h=(v/max)*(H-2*pd);
    return `<rect x="${(pd+i*bw+.6).toFixed(1)}" y="${(H-pd-h).toFixed(1)}" width="${(bw-1.2).toFixed(1)}" height="${h.toFixed(1)}" rx="1.5" fill="${v>goal?'#f0883e':'#238636'}"/>`;}).join("");
  const gy=H-pd-(goal/max)*(H-2*pd);
  box.innerHTML=`<svg viewBox="0 0 ${W} ${H}" style="width:100%;height:${H}px">${bars}
    <line x1="${pd}" y1="${gy.toFixed(1)}" x2="${W-pd}" y2="${gy.toFixed(1)}" stroke="#8b949e" stroke-dasharray="3 3"/></svg>
    <div style="text-align:center;font-size:10px;color:var(--muted);margin-top:2px">Ziel-Linie ${de(goal)} kcal</div>`;
}
function renderTrends(){
  const s=series();
  const W=s.map(d=>d.morning&&d.morning.weight||null);
  const B=s.map(d=>d.morning&&d.morning.bodyfat||null);
  const K=s.map(d=>{const t=totals(d);return t.kcal||null;});
  const first=W.find(v=>v!=null),last=[...W].reverse().find(v=>v!=null);
  const fb=B.find(v=>v!=null),lb=[...B].reverse().find(v=>v!=null);
  const nav=DB.measurements.length?navyOf(DB.measurements[DB.measurements.length-1],last):null;
  document.getElementById("trendStats").innerHTML=
    `<div><div class="n">${last?de1(last):"—"}</div><div class="l">Gewicht kg</div>
      <div class="d ${last<first?"down":"up"}">${first&&last?(last-first>0?"+":"−")+de1(Math.abs(last-first)):""}</div></div>
     <div><div class="n">${lb?de1(lb):"—"}</div><div class="l">KFA Waage %</div>
      <div class="d ${lb<fb?"down":"up"}">${fb&&lb?(lb-fb>0?"+":"−")+de1(Math.abs(lb-fb))+" pp":""}</div></div>
     <div><div class="n">${nav?de1(nav):"—"}</div><div class="l">KFA Navy %</div><div class="d" style="color:var(--muted)">Maßband</div></div>`;
  lineChart("chartWeight",W,"#3fb950");
  lineChart("chartBf",B,"#58a6ff");
  barChart("chartKcal",K,DB.profile.base+200);
  document.getElementById("heat").innerHTML=s.map(d=>{
    const t=totals(d),pc=t.p?t.p/DB.profile.protein*100:0;
    const col=!t.p?"#1c232c":pc>100?"#3fb950":pc>=90?"#238636":pc>=70?"#1d4d2b":"#241a1a";
    return `<i style="background:${col}"></i>`;}).join("");
}

/* ============ Woche ============ */
let WEEK_OFF=0;
function mondayOf(dateStr,off){
  const d=new Date(dateStr+"T00:00:00");
  const wd=(d.getDay()+6)%7;
  d.setDate(d.getDate()-wd+off*7);
  return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate());
}
function shiftWeek(n){WEEK_OFF+=n;renderWeek();}
function renderWeek(){
  const mon=mondayOf(today(),WEEK_OFF);
  const days=[];for(let i=0;i<7;i++){const d=new Date(mon+"T00:00:00");d.setDate(d.getDate()+i);
    days.push(d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate()));}
  document.getElementById("weekTitle").textContent="Woche "+fmtDate(mon)+" – "+fmtDate(days[6]);
  const rows=days.map(dt=>{const d=DB.days[dt];if(!d)return null;const t=totals(d);
    return {dt,t,w:d.morning&&d.morning.weight};}).filter(x=>x&&(x.t.kcal||x.w));
  document.getElementById("weekBody").innerHTML=rows.length?rows.map(r=>
    `<tr><td>${fmtDate(r.dt)}</td><td>${r.t.kcal?de(r.t.kcal):"—"}</td><td>${r.t.p?R(r.t.p):"—"}</td>
     <td style="${r.t.f>DB.profile.fat?"color:var(--warn)":""}">${r.t.f?R(r.t.f):"—"}</td>
     <td>${r.t.c?R(r.t.c):"—"}</td><td>${r.w?de1(r.w):"—"}</td></tr>`).join("")
    :`<tr><td colspan="6" style="text-align:left;color:var(--muted)">Keine Daten in dieser Woche.</td></tr>`;
  const avg=k=>{const v=rows.map(r=>k==="w"?r.w:r.t[k]).filter(x=>x);return v.length?v.reduce((a,b)=>a+b,0)/v.length:null;};
  const A={kcal:avg("kcal"),p:avg("p"),f:avg("f"),c:avg("c"),w:avg("w")};
  if(rows.length)document.getElementById("weekBody").innerHTML+=
    `<tr class="sum"><td>Ø</td><td>${A.kcal?de(A.kcal):"—"}</td><td>${A.p?R(A.p):"—"}</td>
     <td>${A.f?R(A.f):"—"}</td><td>${A.c?R(A.c):"—"}</td><td>${A.w?de1(A.w):"—"}</td></tr>`;
  const P=DB.profile;
  document.getElementById("weekBalance").innerHTML=
    `<tr><td>Kalorien Ø</td><td>${A.kcal?de(A.kcal):"—"}</td><td style="color:var(--muted)">Basis ${de(P.base)}</td></tr>
     <tr><td>Protein Ø</td><td>${A.p?R(A.p)+" g":"—"}</td><td style="${A.p&&A.p>=P.protein*.95?"color:var(--accent)":"color:var(--warn)"}">${A.p?R(A.p/P.protein*100)+" %":""}</td></tr>
     <tr><td>Fett Ø</td><td>${A.f?R(A.f)+" g":"—"}</td><td style="${A.f&&A.f<=P.fat*1.05?"color:var(--accent)":"color:var(--warn)"}">${A.f?R(A.f/P.fat*100)+" %":""}</td></tr>
     <tr><td>Carbs Ø</td><td>${A.c?R(A.c)+" g":"—"}</td><td style="color:var(--muted)">flexibel</td></tr>
     <tr><td>Gewicht Ø</td><td>${A.w?de1(A.w)+" kg":"—"}</td><td style="color:var(--muted)">${rows.length} Tage</td></tr>`;
  const F=[];
  if(A.f&&A.f>P.fat*1.05)F.push(`Fett liegt bei ${R(A.f/P.fat*100)} % des Limits — Öl auf 1 EL pro Mahlzeit begrenzen, Käse und Feta halbieren.`);
  if(A.p&&A.p<P.protein*.95)F.push(`Protein bei ${R(A.p/P.protein*100)} % — mittags mindestens 25 g einplanen, Shake nicht auslassen.`);
  if(A.kcal&&A.kcal>P.base+400)F.push(`Kalorienschnitt ${de(A.kcal)} liegt deutlich über der Basis — Defizit läuft nur bei sehr hohem Sportanteil.`);
  if(rows.length<5)F.push(`Nur ${rows.length} von 7 Tagen erfasst — Lücken verzerren jeden Wochenvergleich.`);
  if(!F.length)F.push("Alles im Rahmen. Protein und Fett liegen im Zielkorridor.");
  document.getElementById("weekFindings").innerHTML=F.map(t=>`<div class="note" style="margin-top:0;margin-bottom:8px">• ${t}</div>`).join("");
}

/* ============ Körper ============ */
function navyOf(m,weight){
  if(!m||!m.waist||!m.neck||m.waist<=m.neck)return null;
  return 495/(1.0324-0.19077*Math.log10(m.waist-m.neck)+0.15456*Math.log10(DB.profile.height))-450;
}
function navy(){
  const w=parseFloat(document.getElementById("nWaist").value),n=parseFloat(document.getElementById("nNeck").value),
        h=parseFloat(document.getElementById("nHip").value);
  const out=document.getElementById("navyOut");
  const bf=navyOf({waist:w,neck:n});
  if(bf==null){out.textContent="Bauch- und Halsmaß eingeben (Bauch > Hals).";return;}
  const kg=lastWeight()||0,fat=kg*bf/100;
  out.innerHTML=`KFA nach US-Navy: <b style="font-size:16px">${de1(bf)} %</b><br>
    ${kg?`Fettmasse ${de1(fat)} kg · Magermasse ${de1(kg-fat)} kg<br>`:""}
    ${h?`WHR ${(w/h).toFixed(3).replace(".",",")} ${w/h>0.95?"— erhöht, primär viszeral":"— im Zielbereich"}`:""}`;
}
