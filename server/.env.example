# Never commit a real value. Configure these secrets in your host's secret manager.
OPENAI_API_KEY=replace_me
# Long random token for a private development deployment. Replace with per-user auth before public release.
KF20_API_TOKEN=replace_with_a_long_random_value
PORT=8787
OPENAI_MODEL=gpt-5.6
# Optional; browser clients only. Native Android clients do not send an Origin header.
KF20_ALLOWED_ORIGIN=
# Per token, per 10-minute window.
KF20_RATE_LIMIT=30

